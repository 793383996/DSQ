{
  "name": "dsq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engineering scaffold for the DSQ static frontend project.",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint Scripts localDev --max-warnings 100",
    "lint:baseline": "node ./localDev/node-scripts/lint-baseline.mjs",
    "lint:fix": "eslint Scripts localDev --fix",
    "format:check": "prettier --check \"Scripts/**/*.js\" \"localDev/**/*.mjs\"",
    "format": "prettier --write \"Scripts/**/*.js\" \"localDev/**/*.mjs\"",
    "smoke": "node ./localDev/node-scripts/smoke.mjs",
    "test:blueprint": "node ./localDev/node-scripts/blueprint-regression.mjs",
    "build": "node ./localDev/node-scripts/build.mjs",
    "verify:dist": "node ./localDev/node-scripts/verify-dist.mjs",
    "test:e2e": "node ./localDev/node-scripts/e2e.mjs",
    "test:integration": "node ./localDev/node-scripts/integration.mjs",
    "test:unit": "vitest run",
    "ci:check": "npm run lint && npm run lint:baseline && npm run format:check && npm run smoke && npm run test:blueprint && npm run test:unit && npm run build && npm run verify:dist && npm run test:e2e && npm run test:integration"
  },
  "engines": {
    "node": "20.19.x"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "playwright": "^1.53.2",
    "prettier": "^3.0.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "Scripts/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "localDev/**/*.mjs": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
