{
  "name": "dsq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engineering scaffold for the DSQ static frontend project.",
  "scripts": {
    "prepare": "husky",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint Scripts localDev --max-warnings 100",
    "lint:baseline": "node ./localDev/node-scripts/lint-baseline.mjs",
    "jquery:check": "node ./localDev/node-scripts/no-jquery-baseline.mjs",
    "docs:check": "node ./localDev/node-scripts/readme-doc-link-check.mjs",
    "guard:globals": "node ./localDev/node-scripts/global-state-guard.mjs",
    "lint:fix": "eslint Scripts localDev --fix",
    "format:check": "prettier --check \"Scripts/**/*.js\" \"localDev/**/*.mjs\"",
    "format": "prettier --write \"Scripts/**/*.js\" \"localDev/**/*.mjs\"",
    "smoke": "node ./localDev/node-scripts/smoke.mjs",
    "check:logic-ids": "node ./localDev/node-scripts/check-logic-id-guards.mjs",
    "test:blueprint": "node ./localDev/node-scripts/blueprint-regression.mjs",
    "build": "npm run build:vite",
    "build:legacy": "node ./localDev/node-scripts/build.mjs",
    "build:vite": "vite build && node ./localDev/node-scripts/post-vite-copy.mjs",
    "verify:legacy-dist": "node ./localDev/node-scripts/verify-dist.mjs",
    "verify:vite-dist": "node ./localDev/node-scripts/verify-vite-dist.mjs",
    "security:vendor": "node ./localDev/node-scripts/vendor-baseline.mjs",
    "security:check": "node ./localDev/node-scripts/security-baseline.mjs && npm run security:vendor",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "monitor:check": "node ./localDev/node-scripts/monitor-baseline.mjs",
    "metrics:check": "node ./localDev/node-scripts/metrics-baseline.mjs",
    "seo:check": "node ./localDev/node-scripts/seo-baseline.mjs",
    "perf:lhci": "node ./localDev/node-scripts/run-lhci.mjs",
    "perf:lhci:quick": "node ./localDev/node-scripts/run-lhci.mjs --quick",
    "test:a11y": "node ./localDev/node-scripts/a11y.mjs",
    "test:e2e": "node ./localDev/node-scripts/e2e.mjs",
    "test:integration": "node ./localDev/node-scripts/integration.mjs",
    "test:unit": "vitest run",
    "ci:check": "npm run typecheck && npm run docs:check && npm run guard:globals && npm run lint && npm run lint:baseline && npm run jquery:check && npm run format:check && npm run smoke && npm run check:logic-ids && npm run test:blueprint && npm run test:unit && npm run monitor:check && npm run metrics:check && npm run seo:check && npm run build && npm run verify:vite-dist && npm run test:e2e && npm run test:a11y && npm run test:integration"
  },
  "engines": {
    "node": "20.19.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "playwright": "^1.53.2",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.19",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.7"
  },
  "lint-staged": {
    "Scripts/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "localDev/**/*.mjs": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0"
  }
}
